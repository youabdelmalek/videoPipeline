# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Moonshot / Kimi API key, used by the board rewriter step.
# Get one at https://platform.kimi.ai
MOONSHOT_API_KEY=sk-your-key-here

# Optional: ComfyUI image node settings.
# COMFYUI_PORT=9000
# WORKFLOW_IMAGE_INPUT_DIR=input

# For long-context GPU inference with the Q3_K_XL model, set these on the
# Ollama server process (not only in this app's .env file):
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_KV_CACHE_TYPE=q8_0
